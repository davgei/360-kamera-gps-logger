[Unit]
Description=360 process queue (extract 3m frames -> flatten -> blur -> upload -> delete raw)
After=network-online.target 360logger-boot.service
Wants=network-online.target

[Service]
Type=simple
User=__REPO_USER__
Environment=HOME=/home/__REPO_USER__
Environment=PATH=/home/__REPO_USER__/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=__REPO_DIR__
ExecStart=/usr/bin/python3 -m recorder.process_queue
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
